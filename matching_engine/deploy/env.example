# Copiar como deploy/.env (NO subir a git) y completar.
# Token obligatorio si el servicio no está solo en localhost. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PYR_API_TOKEN=
# Política por defecto del servicio (vacío = v0.2). Recomendado para 2027: la v0.3 provisional.
PYR_POLICY=/app/pyr_matching/config/policy_pyr_v03_provisional.json
# Registro de modelos (opcional). Si existe un modelo ACTIVO compatible, se usa.
PYR_REGISTRY=
# Tamaño máximo de carga en MB.
PYR_API_MAX_MB=25
